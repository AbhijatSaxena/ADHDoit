rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Deny everything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self-creation allowed but role is locked to 'viewer' — UI sign-up is disabled; only the Firebase console creates accounts
      allow create: if isOwner(uid) && request.resource.data.role == 'viewer';
      allow update, delete: if isAdmin();

      match /todos/{todoId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /comments/{commentId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }

      match /hubs/{hubId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /tasks/{taskId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
    }

    match /sessions/{sessionId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /focusState/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
